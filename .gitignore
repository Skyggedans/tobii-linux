/target
tobii_stream*.bin

# The release packages `make package` builds.
/dist/

# Local AI pre-commit review artifacts
.local_ai/

# Research captures, logs and analysis output (see fixtures/README.md)
/fixtures/

# Unrelated third-party download that landed in the repo root; left on
# disk untouched, just not tracked.
/gameshell*

# Python bytecode from running tools/abi/dll_abi.py
__pycache__/

# The per-image outputs of image83-replay --fits and --landmarks come from images of a face and
# belong under fixtures/ (tools/headpose/README.md); these catch their usual names elsewhere.
/fits_*.csv
*.f32

# Android: Gradle/IDE state and build output, the machine-local SDK path,
# and the jniLibs .so (built from crates/tobii-android with `cargo ndk`;
# see android/README.md).
/android/.gradle/
/android/.kotlin/
/android/.idea/
/android/local.properties
/android/*/build/
/android/*/*/build/
/android/**/jniLibs/
