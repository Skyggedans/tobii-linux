[Unit]
Description=Tobii Eye Tracker 5 daemon (head/gaze/presence broker)
Documentation=https://github.com/  # tobii5-init-replay
# Start after the user session is up so XDG_RUNTIME_DIR exists.
After=default.target

[Service]
Type=simple
# Dev build path; change to /usr/local/bin/tobiid once installed.
ExecStart=%h/Work/tobii/target/release/tobiid
Restart=on-failure
RestartSec=2
# The daemon claims the USB device; keep it lean.
Nice=-5
# Keep the device warm so client connects are instant (the IR illuminator stays
# on while the service runs). Uncomment for head tracking:
#Environment=TOBII_PREWARM=head
# Skipping the USB reset shaves a couple seconds off startup:
#Environment=TOBII_NO_RESET=1

[Install]
WantedBy=default.target
